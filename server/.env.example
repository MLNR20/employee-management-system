# Copy this file to .env and fill it in. .env is ignored by git and docker.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority&tls=true
# PORT=3002
# Token signing secrets: three different long random values. Without them the server makes up its own at
# each start, which signs everyone out on restart. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# JWT_SECRET=
# REFRESH_TOKEN_SECRET=
# EMPLOYEE_JWT_SECRET=
# WORK_UTC_OFFSET_MINUTES=480
# Browsers may only call the API from these addresses (comma-separated). Leave empty for local development.
# CORS_ORIGINS=https://your-client.onrender.com,http://localhost:3000
# Rate limiting per client IP: 300 requests per 15 minutes overall, and 10 failed sign-in/register/refresh
# attempts per 15 minutes. Windows are in milliseconds.
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=300
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=10
# Reverse proxies in front of the server (Render: 1). Leave 0 when running locally without one.
# TRUST_PROXY=1
